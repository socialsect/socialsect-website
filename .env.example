# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Resend (Email)
RESEND_API_KEY=re_your_key
RESEND_FROM_EMAIL=noreply@gosocialsect.com
RESEND_NOTIFY_EMAILS=team@gosocialsect.com

# OpenRouter (AI Consultant)
OPENROUTER_API_KEY=sk_live_your_key
OPENROUTER_MODEL=deepseek/deepseek-chat-v3

# Google PageSpeed Insights API (for website performance analysis)
# Get API key from: https://developers.google.com/speed/pagespeed/insights
GOOGLE_PAGESPEED_API_KEY=your_google_api_key

# Sanity CMS (existing)
VITE_SANITY_PROJECT_ID=your_project_id
VITE_SANITY_DATASET=production
VITE_SANITY_API_VERSION=2024-01-01

