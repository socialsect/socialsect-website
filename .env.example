# Place this file as socialsect-website/.env (same folder as package.json)

RESEND_API_KEY=re_your_api_key_here

# Plain email only (recommended). Do NOT use "Name <email>" here.
RESEND_FROM_EMAIL=onboarding@resend.dev
# Optional display name (only if you want "Socialsect <noreply@...>" in inboxes):
# RESEND_FROM_NAME=Socialsect

RESEND_NOTIFY_EMAILS=hello@gosocialsect.com,rayansh@gosocialsect.com
RESEND_CC_EMAILS=

# Temporary Resend sandbox (only delivers to your Resend login email):
# RESEND_FROM_EMAIL=onbosarding@resend.dev

# npm run check:resend

# Supabase — unified submission log (server only; use service_role, never anon in .env here)
# Use Project URL only — NOT the /rest/v1/ URL from the API docs
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
